# Default settings for the api-gateway process.
#
# These are plain environment variables, read directly by the gateway at
# startup. Source this file before launching, or export the variables yourself:
#
#   set -a && source config/gateway.env && set +a && ./build/api-gateway
#
# Command-line flags (--host, --port) take precedence over these values.

# Interface to bind. Use 127.0.0.1 to accept local connections only.
GATEWAY_HOST=0.0.0.0

# TCP port to listen on (1-65535).
GATEWAY_PORT=8080
